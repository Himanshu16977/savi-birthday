# ====================================================================
# Savi's Magical First Birthday - Environment Configuration Template
# ====================================================================
# NOTE: Never commit your actual `.env` file containing secret API keys.
# Copy this file to `.env.local` for local development or configure these
# in your Vercel Project Dashboard under "Settings" > "Environment Variables".

# 1. Application URL (Optional, defaults to automatic Vercel domain)
VITE_APP_URL=https://savi-birthday.vercel.app

# 2. Optional: Cloudinary Cloud Storage for Shared Universal Photo Uploads
# If left blank, the website uses browser-native IndexedDB persistent storage per device.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# 3. Optional: Custom Background Royalty-Free Audio File URL
# Leave empty to use the built-in procedural Web Audio music box arrangement
VITE_BACKGROUND_MUSIC_URL=

